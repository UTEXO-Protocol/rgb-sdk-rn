{
  "name": "@utexo/rgb-lib-rn",
  "version": "1.0.0-beta.40",
  "description": "RGB_L1 wallet engine for React Native: native rgb-lib (iOS and Android) behind the @utexo/rgb-sdk-core SharedWalletApi contract",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/module",
    "lib/typescript/src",
    "lib/typescript/package.json",
    "android",
    "ios",
    "scripts/setup-rgb-lib-bindings.mjs",
    "*.podspec",
    "!lib/module/bindings/**",
    "!lib/typescript/src/bindings/**",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!ios/*.zip",
    "!ios/RgbLibBindings/**",
    "!android/src/test/**",
    "!android/src/androidTest/**"
  ],
  "scripts": {
    "dev": "tsc -w",
    "clean": "del-cli android/build ios/build lib",
    "prepare": "bob build",
    "postinstall": "node scripts/setup-rgb-lib-bindings.mjs --optional",
    "typecheck": "tsc",
    "codegen": "mkdir -p android/build/generated/source/codegen && node node_modules/@react-native/codegen/lib/cli/combine/combine-js-to-schema-cli.js android/build/generated/source/codegen/schema.json src/binding && node node_modules/@react-native/codegen/lib/cli/generators/generate-all.js android/build/generated/source/codegen/schema.json RgbLibSpec android/build/generated/source/codegen com.utexo.rgblibrn",
    "codegen:rgb-lib": "node scripts/generate-rgb-lib-bridge.mjs && node scripts/generate-rgb-lib-dtos.mjs",
    "test:rgb-lib:ios": "node scripts/check-rgb-lib-ios.mjs",
    "test:rgb-lib:android": "node scripts/check-rgb-lib-android.mjs",
    "test:rgb-lib": "bob build && node scripts/generate-rgb-lib-bridge.mjs --check && node scripts/generate-rgb-lib-dtos.mjs --check && node --experimental-loader ./tests/support/rn-stub-loader.mjs --test tests/rgb-lib.test.mjs",
    "build": "bob build",
    "build:watch": "tsc -w",
    "prettier": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "version:patch": "npm version patch && git push && git push --tags && npm publish --access public",
    "version:minor": "npm version minor && git push && git push --tags && npm publish --access public",
    "version:major": "npm version major && git push && git push --tags && npm publish --access public",
    "check:contract": "bob build && node --experimental-loader ./tests/support/rn-stub-loader.mjs scripts/check-contract.mjs",
    "test": "npm run typecheck && npm run check:contract && npm run test:rgb-lib",
    "bindings:rgb-lib": "node scripts/setup-rgb-lib-bindings.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UTEXO-Protocol/rgb-lib-rn.git"
  },
  "keywords": [
    "rgb",
    "rgb-protocol",
    "rgb-lib",
    "bitcoin",
    "wallet",
    "react-native",
    "turbo-module",
    "ios",
    "android"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@utexo/rgb-sdk-core": "^0.1.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@utexo/rgb-sdk-core": "file:../.local-packages/utexo-rgb-sdk-core-0.1.0.tgz",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.0.0",
    "react-native": "*",
    "react-native-builder-bob": "^0.40.17",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@scure/bip32": "^2.0.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RgbLibSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.utexo.rgblibrn"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
